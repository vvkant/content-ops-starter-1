            <div style="margin-top:8px;">
              <span class="tag"><a target="_blank" rel="noopener" href="https://www.google.com/maps?q=Gran+V%C3%ADa+Madrid&output=embed">Gran Vía map</a></span>
              <span class="tag"><a target="_blank" rel="noopener" href="https://www.google.com/maps?q=Las+Rozas+Village&output=embed">Las Rozas Village map</a></span>
            </div>
          </div>
        </div>

        <div class="footer">
          Want more beach? Add a day trip from Seville to Cádiz (fast train) or from Barcelona to Sitges (short train).
          But with 10 days and 4 cities, beach is best as a <b>sunset walk</b>, not a full additional destination.
        </div>
      </div>
    </section>

  </main>

  <script>
    // ---------- Helpers ----------
    const $ = (sel, el=document) => el.querySelector(sel);
    const $$ = (sel, el=document) => Array.from(el.querySelectorAll(sel));

    function fmt(valueEUR){
      const currency = $('#currency').value;
      const fx = Number($('#fx').value || 0);
      if (currency === 'EUR'){
        return new Intl.NumberFormat('en-IE', { style:'currency', currency:'EUR', maximumFractionDigits:0 }).format(valueEUR);
      }
      const inr = valueEUR * (fx || 90);
      return '₹' + new Intl.NumberFormat('en-IN', { maximumFractionDigits:0 }).format(inr);
    }

    function sumChecked(selector){
      return $$(selector).filter(x => x.checked).reduce((a,x) => a + Number(x.dataset.cost || 0), 0);
    }

    function updateBudget(){
      const nights = Number($('#nights').value || 0);
      const hotelPerNight = Number($('#hotelPerNight').value || 0);
      const mealsPerDay = Number($('#mealsPerDay').value || 0);
      const localTransportPerDay = Number($('#localTransportPerDay').value || 0);
      const days = 10;

      const hotelTotal = nights * hotelPerNight;
      const dailyTotal = days * (mealsPerDay + localTransportPerDay);
      const trainsTotal = sumChecked('input.train');
      const activitiesTotal = sumChecked('input.ticket');
      const shopping = Number($('#shoppingBudget').value || 0);
      const buffer = Number($('#miscBuffer').value || 0);

      const grand = hotelTotal + dailyTotal + trainsTotal + activitiesTotal + shopping + buffer;

      $('#tHotel').textContent = fmt(hotelTotal);
      $('#tDaily').textContent = fmt(dailyTotal);
      $('#tMoves').textContent = fmt(trainsTotal);
      $('#tActivities').textContent = fmt(activitiesTotal);
      $('#tShopping').textContent = fmt(shopping);
      $('#tBuffer').textContent = fmt(buffer);
      $('#tGrand').textContent = fmt(grand);

      const lines = [];
      lines.push(`Hotels: ${fmt(hotelTotal)} (${nights} nights × ${fmt(hotelPerNight)} per night)`);
      lines.push(`Meals+Local transport: ${fmt(dailyTotal)} (10 days × ${fmt(mealsPerDay + localTransportPerDay)} per day)`);
      lines.push(`Intercity trains: ${fmt(trainsTotal)}`);
      lines.push(`Attractions/tours: ${fmt(activitiesTotal)}`);
      lines.push(`Shopping: ${fmt(shopping)}`);
      lines.push(`Buffer: ${fmt(buffer)}`);

      $('#budgetBreakdown').innerHTML = '<b>Budget breakdown:</b><br>' + lines.map(x => '• ' + x).join('<br>');
    }

    function resetBudget(){
      $('#currency').value = 'EUR';
      $('#fx').value = 90;
      $('#nights').value = 9;
      $('#hotelPerNight').value = 180;
      $('#mealsPerDay').value = 100;
      $('#localTransportPerDay').value = 20;
      $('#shoppingBudget').value = 350;
      $('#miscBuffer').value = 250;

      $$('input.ticket').forEach(cb => cb.checked = (cb.dataset.name.includes('Sagrada') || cb.dataset.name.includes('Park') || cb.dataset.name.includes('Barça') || cb.dataset.name.includes('Bernabéu') || cb.dataset.name.includes('Alhambra') || cb.dataset.name.includes('Alcázar')));
      $$('input.ticket').forEach(cb => {
        if (cb.dataset.name.includes('Casa Batlló') || cb.dataset.name.includes('Flamenco')) cb.checked = false;
      });

      $$('input.train').forEach(cb => cb.checked = !cb.dataset.name.includes('optional'));
      updateBudget();
    }

    async function copyText(text){
      try{
        await navigator.clipboard.writeText(text);
        alert('Copied to clipboard ✅');
      }catch(e){
        const ta = document.createElement('textarea');
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
        alert('Copied to clipboard ✅');
      }
    }

    function budgetSummaryText(){
      const hotel = $('#tHotel').textContent;
      const daily = $('#tDaily').textContent;
      const trains = $('#tMoves').textContent;
      const acts = $('#tActivities').textContent;
      const shop = $('#tShopping').textContent;
      const buff = $('#tBuffer').textContent;
      const grand = $('#tGrand').textContent;

      const tickets = $$('input.ticket').filter(x=>x.checked).map(x=>`- ${x.dataset.name}: €${x.dataset.cost}`).join('\n') || '(none)';
      const trainsSel = $$('input.train').filter(x=>x.checked).map(x=>`- ${x.dataset.name}: €${x.dataset.cost}`).join('\n') || '(none)';

      return [
        'Spain Trip Budget Summary (Interactive Page)',
        '------------------------------------------',
        `Hotels: ${hotel}`,
        `Meals+Local transport: ${daily}`,
        `Intercity trains: ${trains}`,
        `Attractions/tours: ${acts}`,
        `Shopping: ${shop}`,
        `Buffer: ${buff}`,
        '',
        `GRAND TOTAL: ${grand}`,
        '',
        'Selected trains:',
        trainsSel,
        '',
        'Selected attractions:',
        tickets
      ].join('\n');
    }

    // ---------- Packing generator ----------
    function generatePacking(){
      const cards = $$('[data-city]');
      const highs = cards.map(c => Number($('[data-high]', c)?.dataset.high || 0));
      const lows = cards.map(c => Number($('[data-low]', c)?.dataset.low || 0));
      const anyRain = cards.some(c => $('[data-rain]', c)?.dataset.rain === 'light');
      const maxHigh = Math.max(...highs);
      const minLow = Math.min(...lows);

      const needsLightJacket = minLow <= 9;
      const needsWarmLayer = minLow <= 7;
      const needsSun = maxHigh >= 24;

      const items = [];
      items.push({t:'Walking shoes (2 pairs if possible)', d:'Cobblestones + long days. Rotate shoes to avoid blisters.'});
      items.push({t:'Light layers (t-shirts + long-sleeve)', d:`Days up to ~${maxHigh}°C; evenings can drop to ~${minLow}°C.`});
      if (needsLightJacket) items.push({t:'Light jacket / windbreaker', d:'For Madrid/Granada evenings and Barcelona breeze.'});
      if (needsWarmLayer) items.push({t:'Thin sweater / fleece', d:'Granada can feel cold at night due to elevation.'});
      if (needsSun) items.push({t:'Sun hat + sunglasses', d:'Seville afternoons can feel hot and bright.'});
      if (needsSun) items.push({t:'Sunscreen (SPF 30+)', d:'Outdoor sightseeing + parks.'});
      if (anyRain) items.push({t:'Compact umbrella or packable rain jacket', d:'Barcelona/Madrid can have light showers.'});
      items.push({t:'Daypack (one per adult)', d:'Water, snacks, power bank, light layer.'});
      items.push({t:'Reusable water bottles', d:'Refill often; helps in Seville.'});
      items.push({t:'Power bank + charging cables', d:'Maps + photos all day.'});
      items.push({t:'Tissues + wet wipes', d:'Public restrooms and snack cleanup.'});
      items.push({t:'Blister plasters', d:'Walking-heavy itinerary: prevention beats regret.'});
      items.push({t:'Basic meds (kids + adults)', d:'Motion, fever, allergies; carry prescriptions if needed.'});
      items.push({t:'Travel adaptor (Type C/F, 230V)', d:'Spain standard plugs.'});
      items.push({t:'Passport copies (digital + paper)', d:'Helpful for trains/tickets.'});
      items.push({t:'Train entertainment for kids', d:'Cards, small game, downloaded shows.'});
      items.push({t:'Snacks for “emergency diplomacy”', d:'You know exactly what this means.'});

      const wrap = $('#packingList');
      wrap.innerHTML = '';
      items.forEach((it, idx) => {
        const div = document.createElement('div');
        div.className = 'checkitem';
        div.innerHTML = `
          <label style="margin:0; display:flex; align-items:flex-start; gap:10px; cursor:pointer;">
            <input type="checkbox" class="packcb" data-i="${idx}">
            <div>
              <b>${it.t}</b>
              <div class="mini">${it.d}</div>
            </div>
          </label>
        `;
        wrap.appendChild(div);
      });
    }

    function packingText(){
      const rows = $$('.checkitem b').map(b => '• ' + b.textContent);
      return ['Spain Trip Packing Checklist', '--------------------------', ...rows].join('\n');
    }

    function setPackingChecks(state){
      $$('.packcb').forEach(cb => cb.checked = state);
    }

    // ---------- Print / PDF ----------
    function doPrint(){
      document.body.classList.add('print-mode');
      setTimeout(() => {
        window.print();
        setTimeout(() => document.body.classList.remove('print-mode'), 300);
      }, 120);
    }

    // ---------- Wire ----------
    function wire(){
      const budgetInputs = ['currency','fx','nights','hotelPerNight','mealsPerDay','localTransportPerDay','shoppingBudget','miscBuffer'];
      budgetInputs.forEach(id => $('#'+id).addEventListener('input', updateBudget));
      $$('input.ticket, input.train').forEach(cb => cb.addEventListener('change', updateBudget));

      $('#btnResetBudget').addEventListener('click', () => resetBudget());
      $('#btnCopyBudget').addEventListener('click', () => copyText(budgetSummaryText()));

      $('#btnGeneratePacking').addEventListener('click', () => generatePacking());
      $('#btnCheckAll').addEventListener('click', () => setPackingChecks(true));
      $('#btnUncheckAll').addEventListener('click', () => setPackingChecks(false));
      $('#btnCopyPacking').addEventListener('click', () => {
        if (!$('.checkitem')) generatePacking();
        copyText(packingText());
      });

      $('#btnPrint').addEventListener('click', doPrint);

      // UX: close other itinerary days when opening one
      const dayDetails = $$('#itinerary details');
      dayDetails.forEach(d => d.addEventListener('toggle', () => {
        if (d.open) {
          dayDetails.forEach(other => { if (other !== d) other.open = false; });
          d.scrollIntoView({behavior:'smooth', block:'start'});
        }
      }));
    }

    wire();
    resetBudget();
  </script>
</body>
</html>
