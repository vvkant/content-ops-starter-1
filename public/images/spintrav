<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>10-Day Family Itinerary: Spain (April 2026) — Interactive</title>
  <meta name="description" content="Spain itinerary with hour-by-hour plan, maps, photos, veg restaurants, budget calculator, packing checklist, and print-to-PDF mode." />

  <style>
    :root{
      --bg:#0b0f14;
      --card:#101722;
      --text:#e8eef7;
      --muted:#a9b6c7;
      --accent:#5dd6ff;
      --accent2:#9cff6a;
      --warn:#ffd36a;
      --border:rgba(255,255,255,.08);
      --shadow: 0 10px 30px rgba(0,0,0,.35);
      --radius:18px;
      --max:1120px;
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Apple Color Emoji","Segoe UI Emoji";
      background: radial-gradient(1200px 800px at 20% 0%, rgba(93,214,255,.18), transparent 55%),
                  radial-gradient(900px 700px at 80% 10%, rgba(156,255,106,.12), transparent 55%),
                  var(--bg);
      color:var(--text);
      line-height:1.5;
    }
    a{color:var(--accent); text-decoration:none}
    a:hover{text-decoration:underline}
    header{padding:28px 18px 10px;}
    .wrap{max-width:var(--max); margin:0 auto;}
    .hero{
      background: linear-gradient(180deg, rgba(16,23,34,.85), rgba(16,23,34,.65));
      border:1px solid var(--border);
      box-shadow: var(--shadow);
      border-radius: var(--radius);
      overflow:hidden;
    }
    .hero-top{padding:22px 22px 14px; display:grid; gap:14px;}
    .kicker{display:flex; gap:10px; flex-wrap:wrap; align-items:center; color:var(--muted); font-size:14px;}
    .pill{display:inline-flex; align-items:center; gap:8px; padding:6px 10px; border-radius:999px; border:1px solid var(--border); background: rgba(255,255,255,.03);}
    h1{margin:6px 0 0; font-size:32px; letter-spacing:-.4px; line-height:1.1;}
    .sub{margin:0; color:var(--muted); max-width: 92ch;}
    .btnrow{display:flex; gap:10px; flex-wrap:wrap}
    .btn{
      display:inline-flex; align-items:center; gap:8px;
      padding:10px 12px; border-radius:12px;
      border:1px solid var(--border); background: rgba(255,255,255,.03);
      color: var(--text); font-size:14px; cursor:pointer;
    }
    .btn:hover{text-decoration:none; border-color: rgba(93,214,255,.3)}
    .btn.primary{border-color: rgba(93,214,255,.35); background: rgba(93,214,255,.08)}
    .btn.good{border-color: rgba(156,255,106,.35); background: rgba(156,255,106,.08)}
    .btn.warn{border-color: rgba(255,211,106,.35); background: rgba(255,211,106,.08)}
    nav{
      position:sticky; top:0; z-index:50;
      backdrop-filter: blur(10px);
      background: rgba(11,15,20,.72);
      border-bottom:1px solid var(--border);
    }
    .navin{
      max-width:var(--max); margin:0 auto;
      display:flex; gap:10px; flex-wrap:wrap;
      padding:10px 14px; align-items:center;
    }
    .navin a{
      padding:8px 10px; border-radius: 10px;
      border:1px solid transparent; color:#d8e6ff; font-size:14px;
    }
    .navin a:hover{border-color: var(--border); background: rgba(255,255,255,.03); text-decoration:none}

    main{padding:18px 14px 60px}
    section{margin-top:18px}
    .panel{
      background: rgba(16,23,34,.72);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      overflow:hidden;
    }
    .panel-inner{padding:14px}
    .section-title{
      display:flex; align-items:flex-end; justify-content:space-between; gap:12px;
      margin: 6px 0 10px;
    }
    .section-title h2{margin:0; font-size:20px; letter-spacing:-.2px;}
    .section-title p{margin:0; color:var(--muted); font-size:14px}

    .table{width:100%; border-collapse: collapse; font-size:14px}
    .table th, .table td{border-bottom:1px solid var(--border); padding:10px 10px; vertical-align:top;}
    .table th{color:#dbe7ff; text-align:left; font-weight:600}
    .table td{color:#e7eefb}
    .muted{color:var(--muted)}
    .tag{
      display:inline-flex; gap:8px; align-items:center;
      padding:4px 8px; border-radius:999px;
      border:1px solid var(--border);
      background: rgba(255,255,255,.03);
      font-size:12px; color:#d7e3ff;
      margin-right:6px; margin-top:4px;
    }
    .two{display:grid; grid-template-columns: 1fr 1fr; gap:12px;}
    @media (max-width: 900px){.two{grid-template-columns:1fr}}
    .three{display:grid; grid-template-columns: 1fr 1fr 1fr; gap:12px;}
    @media (max-width: 980px){.three{grid-template-columns:1fr}}
    .card{
      background: rgba(255,255,255,.03);
      border:1px solid var(--border);
      border-radius: 14px;
      padding:12px;
    }
    .callout{
      border-left: 4px solid var(--accent2);
      padding:12px 12px;
      background: rgba(156,255,106,.06);
      border-radius: 12px;
      border:1px solid rgba(156,255,106,.18);
      color:#eafff0;
    }
    .callout.warn{
      border-left-color: var(--warn);
      background: rgba(255,211,106,.06);
      border-color: rgba(255,211,106,.18);
      color:#fff4df;
    }
    details{
      background: rgba(255,255,255,.02);
      border:1px solid var(--border);
      border-radius: 14px;
      padding:10px 12px;
    }
    details + details{margin-top:10px}
    summary{cursor:pointer; list-style:none; display:flex; align-items:center; justify-content:space-between; gap:10px;}
    summary::-webkit-details-marker{display:none}
    .sum-left{display:flex; flex-direction:column; gap:2px;}
    .sum-left b{font-size:15px}
    .sum-left small{color:var(--muted)}
    .sum-right{display:flex; gap:8px; align-items:center; flex-wrap:wrap; justify-content:flex-end; color: var(--muted); font-size:12px;}

    .timeline{
      margin-top:12px;
      border-top:1px dashed var(--border);
      padding-top:12px;
      display:grid;
      gap:10px;
    }
    .slot{
      display:grid;
      grid-template-columns: 125px 1fr;
      gap:10px;
      padding:10px;
      border:1px solid var(--border);
      background: rgba(0,0,0,.16);
      border-radius: 14px;
    }
    @media (max-width: 700px){ .slot{grid-template-columns:1fr} }
    .time{font-weight:800; color:#dbe7ff;}
    .slot p{margin:0}
    .slot .meta{margin-top:6px; color:var(--muted); font-size:13px;}

    .field{display:grid; grid-template-columns: 1fr 1fr; gap:10px; align-items:end; margin-top:10px;}
    @media (max-width: 900px){.field{grid-template-columns:1fr}}
    label{display:block; font-size:13px; color:#dbe7ff; margin-bottom:6px;}
    input[type="number"], input[type="text"], select{
      width:100%;
      padding:10px 10px;
      border-radius: 12px;
      border:1px solid var(--border);
      background: rgba(0,0,0,.18);
      color: var(--text);
      outline:none;
    }
    input[type="checkbox"]{transform: scale(1.1); margin-right:8px}
    .row{display:flex; gap:10px; flex-wrap:wrap; align-items:center}
    .right{margin-left:auto}
    .totals{
      display:grid;
      grid-template-columns: repeat(4, minmax(0,1fr));
      gap:10px;
      margin-top:10px;
    }
    @media (max-width: 900px){.totals{grid-template-columns:1fr 1fr}}
    @media (max-width: 520px){.totals{grid-template-columns:1fr}}
    .kpi{
      padding:12px;
      border-radius: 14px;
      border:1px solid var(--border);
      background: rgba(255,255,255,.03);
    }
    .kpi .v{font-size:18px; font-weight:900}
    .kpi .l{color:var(--muted); font-size:12px}

    .list{display:grid; gap:8px; margin-top:10px;}
    .checkitem{
      display:flex; align-items:flex-start; gap:10px;
      padding:10px;
      border-radius: 14px;
      border:1px solid var(--border);
      background: rgba(255,255,255,.02);
    }
    .checkitem b{display:block}
    .mini{font-size:12px; color:var(--muted)}
    .note{margin-top:10px; color:var(--muted); font-size:13px}
    .footer{color:var(--muted); font-size:13px; margin-top:18px;}

    .media{
      display:grid;
      grid-template-columns: 1.15fr .85fr;
      gap:10px;
      margin-top:10px;
      align-items:start;
    }
    @media (max-width: 980px){.media{grid-template-columns:1fr}}
    .photo{
      width:100%;
      border-radius: 14px;
      border:1px solid var(--border);
      background: rgba(0,0,0,.22);
      overflow:hidden;
    }
    .photo img{width:100%; height:auto; display:block}
    .map{
      width:100%;
      height:240px;
      border-radius: 14px;
      border:1px solid var(--border);
      overflow:hidden;
      background: rgba(0,0,0,.18);
    }
    .map iframe{width:100%; height:100%; border:0}

    /* PRINT-FRIENDLY MODE */
    body.print-mode{
      background:#fff;
      color:#000;
    }
    body.print-mode a{color:#000; text-decoration:underline}
    body.print-mode nav,
    body.print-mode .btnrow,
    body.print-mode .note,
    body.print-mode .footer,
    body.print-mode .mini{
      display:none !important;
    }
    body.print-mode .hero,
    body.print-mode .panel{
      box-shadow:none;
      background:#fff;
      border:1px solid #ddd;
    }
    body.print-mode .card,
    body.print-mode details,
    body.print-mode .slot,
    body.print-mode .kpi,
    body.print-mode .checkitem{
      background:#fff;
      border:1px solid #e5e5e5;
      color:#000;
    }
    body.print-mode .muted{color:#333}
    body.print-mode .tag{border-color:#ddd; color:#000; background:#fff}
    body.print-mode .table th, body.print-mode .table td{border-bottom:1px solid #eee; color:#000}
    body.print-mode .callout{border:1px solid #ddd; background:#fff; color:#000}
    body.print-mode .callout.warn{border:1px solid #ddd; background:#fff}
    body.print-mode .map{display:none !important;} /* maps often print badly */
  </style>
</head>

<body>
  <header class="wrap">
    <div class="hero">
      <div class="hero-top">
        <div class="kicker">
          <span class="pill">📅 April 2026</span>
          <span class="pill">👨‍👩‍👧‍👦 2 Adults + 2 Kids (8 & 14)</span>
          <span class="pill">⚽ Football: Barça + Real Madrid</span>
          <span class="pill">🥗 Vegetarian-friendly</span>
          <span class="pill">🚶 Walk-first</span>
          <span class="pill">🧮 Budget + Packing + PDF</span>
        </div>

        <h1>Spain Spring 2026 — 10 Days, Hour-by-Hour (Family + Veg + Football)</h1>
        <p class="sub">
          Route: Barcelona (3N) → Madrid (2N) → Granada (1N) → Seville (3N). Built for walking, culture, gardens, museums, kid-friendly pacing, and vegetarian meals.
          Includes embedded maps + photos of key monuments, plus a restaurant guide per city with map links.
        </p>

        <div class="btnrow">
          <a class="btn" href="#highlights">✨ Highlights</a>
          <a class="btn" href="#hotels">🏨 Hotels</a>
          <a class="btn" href="#restaurants">🥗 Restaurants</a>
          <a class="btn" href="#budget">🧮 Budget Calculator</a>
          <a class="btn" href="#packing">🧳 Packing</a>
          <a class="btn" href="#trains">🚄 Trains</a>
          <a class="btn primary" href="#itinerary">🗓️ Full Itinerary</a>
          <button class="btn warn right" id="btnPrint">🖨️ Print / Save to PDF</button>
        </div>

        <div class="callout warn">
          <b>One-click PDF:</b> Click <b>Print / Save to PDF</b> → choose <b>Destination: Save as PDF</b>.
          Page switches to a clean print layout automatically.
        </div>
      </div>
    </div>
  </header>

  <nav>
    <div class="navin">
      <a href="#highlights">Highlights</a>
      <a href="#weather">Weather</a>
      <a href="#hotels">Hotels</a>
      <a href="#restaurants">Restaurants</a>
      <a href="#budget">Budget</a>
      <a href="#packing">Packing</a>
      <a href="#trains">Trains</a>
      <a href="#itinerary">Itinerary</a>
      <a href="#tips">Tips</a>
    </div>
  </nav>

  <main class="wrap">

    <!-- HIGHLIGHTS -->
    <section id="highlights" class="panel">
      <div class="panel-inner">
        <div class="section-title">
          <h2>Daywise Highlights</h2>
          <p>Quick scan of the big moments (and kid hooks).</p>
        </div>

        <table class="table">
          <thead>
            <tr>
              <th>Day</th>
              <th>City</th>
              <th>Key highlights</th>
              <th>Kid / football hooks</th>
            </tr>
          </thead>
          <tbody>
            <tr><td><b>1</b></td><td>Barcelona</td><td>Gothic Quarter • Las Ramblas • Ciutadella Park • Magic Fountain</td><td>Street performers + big park + gelato</td></tr>
            <tr><td><b>2</b></td><td>Barcelona</td><td>Sagrada Família • Park Güell • Passeig de Gràcia (Gaudí houses)</td><td>Mosaic dragon + tower “wow factor”</td></tr>
            <tr><td><b>3</b></td><td>Barcelona</td><td>Barça museum/tour • Outlet shopping • Barceloneta sunset</td><td>⚽ Barça store + beach time</td></tr>
            <tr><td><b>4</b></td><td>Madrid</td><td>High-speed train • Sol/Plaza Mayor • Royal Palace • Temple of Debod</td><td>Big squares + sunset “temple” views</td></tr>
            <tr><td><b>5</b></td><td>Madrid</td><td>Retiro Park • Prado or Reina Sofía • Gran Vía</td><td>⚽ Bernabéu Tour</td></tr>
            <tr><td><b>6</b></td><td>Granada</td><td>Train • Alhambra + Generalife • Albaicín sunset</td><td>Fortress towers + “secret gardens”</td></tr>
            <tr><td><b>7</b></td><td>Seville</td><td>Train • Santa Cruz • Plaza de España • River walk</td><td>Rowboats + space to run</td></tr>
            <tr><td><b>8</b></td><td>Seville</td><td>Real Alcázar • Cathedral/Giralda • Murillo Gardens</td><td>Gardens + tower ramps (no endless stairs)</td></tr>
            <tr><td><b>9</b></td><td>Seville</td><td>Triana Market • Las Setas • Shopping streets • Optional flamenco</td><td>Market snacks + flamenco (short show)</td></tr>
            <tr><td><b>10</b></td><td>Departure</td><td>Easy morning • airport transfer (or AVE to Madrid if needed)</td><td>Last-minute souvenirs</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- WEATHER -->
    <section id="weather" class="panel" style="margin-top:16px;">
      <div class="panel-inner">
        <div class="section-title">
          <h2>April Weather Snapshot (used to generate packing checklist)</h2>
          <p>Mild spring; warmer south; cooler nights inland.</p>
        </div>

        <div class="two">
          <div class="card" data-city="Barcelona">
            <b>Barcelona</b>
            <div class="muted">Mild; sea breeze; occasional short showers.</div>
            <div style="margin-top:8px;">
              <span class="tag" data-high="19">High ~17–19°C</span>
              <span class="tag" data-low="10">Low ~10–12°C</span>
              <span class="tag" data-rain="light">Light rain possible</span>
              <span class="tag" data-wind="breeze">Sea breeze</span>
            </div>
          </div>

          <div class="card" data-city="Madrid">
            <b>Madrid</b>
            <div class="muted">Cool mornings/evenings; warm in sun.</div>
            <div style="margin-top:8px;">
              <span class="tag" data-high="20">High ~18–20°C</span>
              <span class="tag" data-low="7">Low ~7–9°C</span>
              <span class="tag" data-rain="light">Light rain possible</span>
              <span class="tag" data-wind="light">Light wind</span>
            </div>
          </div>

          <div class="card" data-city="Granada">
            <b>Granada</b>
            <div class="muted">Warm days; noticeably cooler nights (elevation).</div>
            <div style="margin-top:8px;">
              <span class="tag" data-high="23">High ~20–23°C</span>
              <span class="tag" data-low="7">Low ~6–9°C</span>
              <span class="tag" data-rain="low">Low rain</span>
              <span class="tag" data-wind="light">Light wind</span>
            </div>
          </div>

          <div class="card" data-city="Seville">
            <b>Seville</b>
            <div class="muted">Warmest; sunny; afternoons can feel hot.</div>
            <div style="margin-top:8px;">
              <span class="tag" data-high="26">High ~23–26°C</span>
              <span class="tag" data-low="13">Low ~12–14°C</span>
              <span class="tag" data-rain="low">Low rain</span>
              <span class="tag" data-wind="light">Light wind</span>
            </div>
          </div>
        </div>

        <p class="note">These are typical April averages; update to date-specific forecasts ~7–10 days before travel.</p>
      </div>
    </section>

    <!-- HOTELS -->
    <section id="hotels" class="panel" style="margin-top:16px;">
      <div class="panel-inner">
        <div class="section-title">
          <h2>Suggested Midrange Hotels (good location)</h2>
          <p>Estimate: family total per night (often 1 family room or 2 rooms). Prices vary by dates/events.</p>
        </div>

        <div class="two">
          <div class="card">
            <b>Barcelona (3 nights) — near Plaça de Catalunya / Eixample</b>
            <div class="muted">Walkable base for Gothic Quarter + Gaudí + metro links.</div>
            <div style="margin-top:8px;">
              <div class="tag">€140–€220/night (family total)</div>
              <div class="tag"><a target="_blank" rel="noopener" href="https://www.booking.com/hotel/es/h10-urquinaona-plaza.html">H10 Urquinaona Plaza (Booking)</a></div>
              <div class="tag"><a target="_blank" rel="noopener" href="https://www.google.com/maps?q=H10+Urquinaona+Plaza+Barcelona&output=embed">Map</a></div>
            </div>
          </div>

          <div class="card">
            <b>Madrid (2 nights) — Chueca / Gran Vía zone</b>
            <div class="muted">Central for Sol, Gran Vía, museums, and metro to Bernabéu.</div>
            <div style="margin-top:8px;">
              <div class="tag">€130–€210/night (family total)</div>
              <div class="tag"><a target="_blank" rel="noopener" href="https://www.booking.com/hotel/es/room-mate-oscar.html">Room Mate Oscar (Booking)</a></div>
              <div class="tag"><a target="_blank" rel="noopener" href="https://www.google.com/maps?q=Room+Mate+Oscar+Madrid&output=embed">Map</a></div>
            </div>
          </div>

          <div class="card">
            <b>Granada (1 night) — Cathedral / Plaza Nueva area</b>
            <div class="muted">Short walks to Albaicín viewpoints + bus/taxi to Alhambra.</div>
            <div style="margin-top:8px;">
              <div class="tag">€90–€160/night (family total)</div>
              <div class="tag"><a target="_blank" rel="noopener" href="https://www.booking.com/hotel/es/anacapri.html">Hotel Anacapri (Booking)</a></div>
              <div class="tag"><a target="_blank" rel="noopener" href="https://www.google.com/maps?q=Hotel+Anacapri+Granada&output=embed">Map</a></div>
            </div>
          </div>

          <div class="card">
            <b>Seville (3 nights) — Santa Cruz / historic center</b>
            <div class="muted">Best walking city; you’ll live outdoors here.</div>
            <div style="margin-top:8px;">
              <div class="tag">€140–€240/night (family total)</div>
              <div class="tag"><a target="_blank" rel="noopener" href="https://www.booking.com/hotel/es/hotel-las-casas-de-la-juderia.html">Las Casas de la Judería (Booking)</a></div>
              <div class="tag"><a target="_blank" rel="noopener" href="https://www.google.com/maps?q=Hotel+Las+Casas+de+la+Juder%C3%ADa+Seville&output=embed">Map</a></div>
            </div>
          </div>
        </div>

        <div class="callout warn" style="margin-top:12px;">
          <b>Booking strategy:</b> April is popular (spring holidays). Lock refundable rates early, then re-check prices 45–60 days out.
        </div>
      </div>
    </section>

    <!-- RESTAURANTS -->
    <section id="restaurants" class="panel" style="margin-top:16px;">
      <div class="panel-inner">
        <div class="section-title">
          <h2>Vegetarian Restaurant Guide (with prices, links, photos, maps)</h2>
          <p>Prices are typical “per person” for a main + drink (unless noted). Always confirm menus for kids / allergies.</p>
        </div>

        <div class="callout">
          <b>Quick rule:</b> Lunch menus in Spain can be better value than dinner. If you want a calmer meal with kids—go earlier.
        </div>

        <!-- Barcelona -->
        <details open>
          <summary>
            <div class="sum-left">
              <b>Barcelona — Vegetarian-friendly picks</b>
              <small>Central, walkable, family-friendly vibes.</small>
            </div>
            <div class="sum-right">
              <span class="tag">€15–€30 pp</span><span class="tag">Plant-forward</span>
            </div>
          </summary>

          <div class="three" style="margin-top:12px;">
            <div class="card">
              <b>Teresa Carles</b>
              <div class="muted">Classic Barcelona vegetarian institution; great for families.</div>
              <div style="margin-top:8px;">
                <span class="tag">€18–€28 pp</span>
                <span class="tag"><a target="_blank" rel="noopener" href="https://www.teresacarles.com/tc/eng">Website</a></span>
                <span class="tag"><a target="_blank" rel="noopener" href="https://www.google.com/maps?q=Teresa+Carles+Barcelona&output=embed">Map</a></span>
              </div>
              <div class="media">
                <div class="photo">
                  <!-- Representative photo (city/food). Restaurant sites often block hotlinking. -->
                  <img alt="Vegetarian Mediterranean plates (representative)" src="https://upload.wikimedia.org/wikipedia/commons/8/82/Vegetarian_platter.jpg">
                </div>
                <div class="map">
                  <iframe loading="lazy" referrerpolicy="no-referrer-when-downgrade"
                    src="https://www.google.com/maps?q=Teresa+Carles+Barcelona&output=embed"></iframe>
                </div>
              </div>
            </div>

            <div class="card">
              <b>Flax & Kale</b>
              <div class="muted">Trendy, mostly plant-based; great brunch option.</div>
              <div style="margin-top:8px;">
